<% provide :title, "Artículos — Rene Garcia" %>
<% provide :description,
"Escribo sobre construir software y negocios siendo neurodivergente. TDAH, AACC, SaaS y autonomía — desde adentro, no desde el manual." %>
<% provide :og_image, image_url("og/posts.png") %>
<% provide :og_image_alt, "Foto de Rene Garcia — Lo que escribo cuando la neurodivergencia se cruza con el codigo, los negocios y la vida real." %>
<% provide :og_type, "website" %>

<% content_for :head do %>
  <% if @page > 1 %>
    <meta name="robots" content="noindex, follow">
    <link rel="prev" href="<%= @page == 2 ? posts_list_url : posts_path(page: @page - 1) %>">
  <% end %>
  <% if @page < (Post.all.size.to_f / @limit).ceil %>
    <link rel="next" href="<%= posts_path(page: @page + 1) %>">
  <% end %>
<% end %>
<div class="pl-6 mb-15 max-w-2xl flex flex-col space-y-5">

  <h1 class="text-4xl font-bold">Lo que escribo cuando la neurodivergencia se cruza
  con el código, los negocios y la vida real.</h1>
  <h2 class="prose prose-2xl">Todo lo que nadie escribe porque implica admitir que no lo tienes resuelto.</h2>
</div>
<div class="flex flex-col max-w-2xl space-y-5">
  <%= render partial: "post_card", collection: @posts, as: :post %>
</div>

<div class="d-flex justify-content-between mb-5">
  <% if @page > 1 %>
    <a href="<%= posts_path(page: @page - 1) %>" class="btn btn-outline-primary">Articulos mas recientes</a>
  <% end %>
  <% if @page < (Post.all.size.to_f / @limit).ceil %>
    <a href="<%= posts_path(page: @page + 1) %>" class="btn btn-outline-primary">Articulos anteriores</a>
  <% end %>
</div>
