<% provide :title, "Rene Garcia — Software, escritura y paternidad neurodivergente" %>
<% provide :description,
"Developer, escritor y padre con TDAH y AACC. Construyo un negocio en software y escritura, sin formulas magicas y con una mente que es mi mayor ventaja y mi peor enemiga." %>
<% provide :og_image, "https://mugshotbot.com/m/5YypF97U" %>
<% provide :og_type, "website" %>

<h1>Posts tagged with "<%= @tag %>"</h1>

<% posts_by_year = @posts.group_by { |post| post.published_at.strftime("%Y") } %>
<% posts_by_year.each do |year, year_posts| %>
  <h2><%= year %></h2>

  <% posts_by_month = year_posts.group_by { |post| post.published_at.strftime("%B") } %>
  <% posts_by_month.each do |month, month_posts| %>
    <h3 class="h6"><%= month %></h3>
    <ul>
      <% month_posts.sort_by(&:published_at).reverse_each do |post| %>
        <li><%= link_to post.title, post_path(post) %></li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<p>
  <%= link_to "← Back to all tags", tags_path %>
</p>
