<%= link_to post_path(post), class: "hover:bg-base-200 rounded-xl" do %>
  <article class="p-4 sm:p-6 flex flex-col space-y-2 sm:space-y-3">
    <header class="flex flex-col space-y-0.5">
      <h2 class="text-xl font-semibold tracking-tighter">
        <%= markdownify(post.title) %>
      </h2>
      <p class="text-xs opacity-50">
        <% if post.published_at %>
          <time datetime="<%= post.published_at.iso8601 %>">
            <%= post.published_at.strftime("%B %-d, %Y") %>
          </time>
        <% end %>
      </p>
    </header>

    <div class="prose prose-sm">
      <%= post.summary %>
    </div>
  </article>
<% end %>
