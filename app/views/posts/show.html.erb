<% provide :title, @post.title %>
<% provide :description, @post.summary %>
<% provide :og_image, @post.og_image %>
<% provide :og_image_alt, "Imagen del articulo: #{@post.title}" %>
<% provide :og_type, "article" %>

<div class="grid grid-cols-[auto_1fr] items-baseline space-x-21.5">
  <%= link_to posts_list_path, class:"btn btn-outline btn-circle border-base-300 shadow-md" do %>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="
        icon icon-tabler icons-tabler-outline icon-tabler-arrow-badge-left size-7
      "
    ><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M11 17h6l-4 -5l4 -5h-6l-4 5z"/></svg>
  <% end %>
  <%= render "post", post: @post %>
</div>

<!-- Schema.org BlogPosting -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "<%= @post.title %>",
  "description": "<%= @post.summary %>",
  "datePublished": "<%= @post.published_at.iso8601 %>",
  "dateModified": "<%= @post.published_at.iso8601 %>",
  "url": "<%= post_url(@post) %>",
  "inLanguage": "es",
  "author": {
    "@type": "Person",
    "name": "Rene Garcia",
    "url": "<%= Rails.application.config.x.site_url %>"
  },
  "publisher": {
    "@type": "Person",
    "name": "Rene Garcia",
    "url": "<%= Rails.application.config.x.site_url %>"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "<%= post_url(@post) %>"
  },
  "image": "<%= @post.og_image %>",
  "keywords": <%= raw @post.tags.to_json if @post.tags&.any? %>
}
</script>
