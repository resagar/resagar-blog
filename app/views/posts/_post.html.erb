<article class="prose">
  <header>
    <h1>
      <%= markdownify(post.title) %>
    </h1>
    <p>
      <% if post.published_at %>
        <time datetime="<%= post.published_at.iso8601 %>"><%= post.published_at.strftime("%B %-d, %Y") %></time>
      <% end %>

      <% if post.tags.any? %>
        • Tagged
        <%= to_sentence post.tags.map { |tag| tag } %>
      <% end %>
    </p>
  </header>

  <div>
    <%= post.content %>
  </div>
</article>
