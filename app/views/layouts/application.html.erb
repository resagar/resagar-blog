<%= render layout: "layouts/base" do %>
  <div
    class="
      bg-base-100 border-x border-base-200 max-w-6xl mx-auto min-h-screen grid
      grid-rows-[auto_1fr_auto] pt-4
    "
  >
    <header class="navbar w-full px-28">
      <%= render partial: "layouts/nav" %>
    </header>

    <main role="main" class="pt-32 pb-28 px-28">

      <%= yield %>
    </main>
    <%= render partial: "layouts/footer" %>
  </div>
<% end %>
