<nav class="w-full flex flex-row justify-between">
  <% unless current_page?(root_path) %>

    <%= link_to root_path do %>
      <%= image_tag("perfil2.jpg", alt: "Rene Garcia (inicio)", class: "size-10 object-cover rounded-full") %>
    <% end %>
  <% else %>
    <div class="size-10"></div>
  <% end %>
  <ul
    class="
      flex flex-row justify-center items-center border border-base-300 rounded-full
      shadow-md px-3 py-0 font-sans font-medium text-sm
    "
  >
    <li class="size-full flex flex-row justify-center items-center">
      <%= link_to "Home",
      root_path,
      class:
        "px-3 h-full flex flex-row items-center hover:text-accent #{"text-accent" if current_page?(root_path)}" %>
    </li>
    <li class="size-full flex flex-row justify-center items-center">
      <%= link_to "About",
      about_path,
      class:
        "px-3 h-full flex flex-row items-center hover:text-accent #{"text-accent" if current_page?(about_path)}" %>
    </li>
    <li class="size-full flex flex-row justify-center items-center">
      <%= link_to "Now",
      now_path,
      class: "px-3 h-full flex flex-row items-center hover:text-accent #{"text-accent" if current_page?(now_path)}" %>
    </li>
    <li class=" size-full flex flex-row justify-center items-center">
      <%= link_to "Articulos",
      posts_list_path,
      class:
        "px-3 h-full flex flex-row items-center hover:text-accent #{"text-accent" if current_page?(posts_list_path)}" %>
    </li>
  </ul>
  <div class="tooltip tooltip-right" data-tip="Rss">
    <%= link_to feed_url(format: :xml), class: "btn btn-outline border-base-300 shadow-md rounded-full" do %>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="icon icon-tabler icons-tabler-outline icon-tabler-rss size-5"
      ><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 19m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/><path d="M4 4a16 16 0 0 1 16 16"/><path d="M4 11a9 9 0 0 1 9 9"/></svg>
    <% end %>
  </div>
</nav>
