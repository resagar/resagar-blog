<% provide :title,
"Rene Garcia - Developer, Escritor, Padre, Neurodivergente, Soloprenuer" %>
<% provide :description,
"Blog sobre Rails, indie hacking y desarrollo freelance. Construyo en público y comparto lo que aprendo." %>
<% provide :og_image, "https://mugshotbot.com/m/5YypF97U" %>
<% provide :og_type, "website" %>

<header class="flex flex-row justify-around">

  <%= image_tag(
    "perfil2.jpg",
    class: "size-72 rounded-xl object-cover rotate-[-3deg]",
  ) %>
  <section class="flex flex-col max-w-md space-y-4">
    <h1 class="text-4xl font-bold tracking-tight"><span class="block">Hola! Soy Rene Garcia,</span>
      Soy
      <span
        class="text-accent"
        data-controller="typed"
        data-typed-words-value='["Developer","Padre","Escritor","Neurodivergente","Solopreneur"]'
        data-typed-colors-value='["#60a5fa","#34d399","#fbbf24","linear-gradient(90deg, #f472b6, #a78bfa, #60a5fa)","#f97316"]'
        aria-label="Developer, Padre, Escritor, Neurodivergente, Solopreneur"
      >Developer</span></h1>
    <h2 class="text-xl opacity-60">
      Escribo sobre como estoy construyendo un negocio digital en solitario,
      como uso y lucho con mi mente caotica con 2e (TDAH y AACC) y como
      equilibro todo esto para ser un padre presente.
    </h2>
    <p class="text-sm">
      <%= link_to "Sobre mi →", about_path, class: "text-accent hover:opacity-60 mr-4" %>
      <%= link_to "Que estoy haciendo ahora →", now_path, class: "text-accent hover:opacity-60" %>
    </p>
    <div class="flex flex-row justify-baseline items-center space-x-5">
      <%= link_to "https://x.com/rsamuelgarcia", target: "_blank", rel: "noopener noreferrer" do %>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="
            icon icon-tabler icons-tabler-outline icon-tabler-brand-x size-6 opacity-50
            hover:opacity-100
          "
        ><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg>

      <% end %>
      <%= link_to "https://www.linkedin.com/in/resagar-backend-developer/", target: "_blank", rel: "noopener noreferrer" do %>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="
            icon icon-tabler icons-tabler-outline icon-tabler-brand-linkedin size-6
            opacity-50 hover:opacity-100
          "
        ><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 11v5"/><path d="M8 8v.01"/><path d="M12 16v-5"/><path d="M16 16v-3a2 2 0 1 0 -4 0"/><path
            d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z"
          /></svg>
      <% end %>
      <%= link_to "https://github.com/resagar", target: "_blank", rel: "noopener noreferrer" do %>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="
            icon icon-tabler icons-tabler-outline icon-tabler-brand-github size-6 opacity-50
            hover:opacity-100
          "
        ><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path
            d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"
          /></svg>
      <% end %>
    </div>
  </section>
</header>
<section class="pt-32">
  <div class="card bg-base-200 border border-base-300 shadow-md hover:shadow-lg transition-shadow">
    <div class="card-body">
      <div class="flex items-center gap-3 mb-3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="icon icon-tabler icons-tabler-outline icon-tabler-clock size-7 text-accent"
        ><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/><path d="M12 7v5l3 2"/></svg>
        <h2 class="text-2xl font-bold font-sans">¿Que estoy haciendo ahora?</h2>
      </div>

      <p class="opacity-70 mb-4 max-w-2xl">
        Mantengo una pagina honesta y actualizada con lo que estoy construyendo,
        aprendiendo y en que estoy enfocado actualmente. Sin filtros, sin SEO,
        sin keywords — solo lo que realmente importa ahora mismo.
      </p>

      <%= link_to now_path, class: "text-accent hover:opacity-60 font-medium inline-flex items-center gap-1" do %>
        Visita mi /now
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
        ><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 12l14 0"/><path d="M13 18l6 -6"/><path d="M13 6l6 6"/></svg>
      <% end %>
    </div>
  </div>
</section>
