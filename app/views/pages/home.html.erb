<section class="flex flex-row pt-32 justify-around">
  <div class="flex flex-col w-56 justify-center items-baseline space-y-3">
    <div class="flex flex-row justify-center items-center space-x-2">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="
          icon icon-tabler icons-tabler-outline icon-tabler-notebook size-5
        "
      ><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path
          d="M6 4h11a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-11a1 1 0 0 1 -1 -1v-14a1 1 0 0 1 1 -1m3 0v18"
        /><path d="M13 8l2 0"/><path d="M13 12l2 0"/></svg>
      <h2 class="text-xl font-bold">
        Articulos
      </h2>
    </div>
    <p class="text-md opacity-60">Mis articulos sobre Ruby on Rails, Hotwire y emprendimiento en
      solitario.</p>
    <%= link_to "leer mas", posts_list_path, class: "text-accent hover:opacity-60" %>
  </div>
  <div class="flex flex-col w-56 justify-center items-baseline space-y-3">
    <div class="flex flex-row justify-center items-center space-x-2">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="icon icon-tabler icons-tabler-outline icon-tabler-mail size-5"
      ><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path
          d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"
        /><path d="M3 7l9 6l9 -6"/></svg>
      <h2 class="text-xl font-bold">
        Newsletter
      </h2>
    </div>
    <p class="text-md opacity-60">Boletin semanal donde hablo sobre mi camino como emprendedor en solitario
      y hago #buildinpublic.</p>
    <%= link_to "suscribete",
    "https://newsletter.resagar.com",
    class: "text-accent hover:opacity-60" %>
  </div>
  <div class="flex flex-col w-56 justify-center items-baseline space-y-3">
    <div class="flex flex-row justify-center items-center space-x-2">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="
          icon icon-tabler icons-tabler-outline icon-tabler-device-laptop size-5
        "
      ><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 19l18 0"/><path
          d="M5 6m0 1a1 1 0 0 1 1 -1h12a1 1 0 0 1 1 1v8a1 1 0 0 1 -1 1h-12a1 1 0 0 1 -1 -1z"
        /></svg>
      <h2 class="text-xl font-bold">
        Services
      </h2>
    </div>
    <p class="text-md opacity-60">Desarrollo software usando Ruby on Rails, si tienes un proyecto en mente
      no dudes en contactarme.</p>
    <%= link_to "Trabaja con Rene",
    posts_list_path,
    class: "text-accent hover:opacity-60" %>
  </div>
</section>
