  "inLanguage": "es",
  "sameAs": [
    "https://x.com/rsamuelgarcia",
    "https://github.com/resagar",
    "https://www.linkedin.com/in/rene-garcia-senior-backend-engineer"
  ],
  "knowsAbout": [
    "Software Development",
    "Writing",
    "ADHD (TDAH)",
    "High Abilities (AACC)",
    "Solopreneurship",
    "Parenting"
  ]
}
</script>
